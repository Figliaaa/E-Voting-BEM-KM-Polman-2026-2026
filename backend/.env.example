# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=pemira_user
DB_PASS=your_db_password
DB_NAME=db_pemira

# Server
PORT=3001
NODE_ENV=development

# JWT Secrets — ganti dengan nilai acak yang kuat!
JWT_SECRET_VOTER=your_voter_secret_here
JWT_SECRET_ADMIN=your_admin_secret_here
VOTER_SECRET=your_voter_secret_here
ADMIN_SECRET=your_admin_secret_here

# CORS
CORS_ORIGIN=http://localhost:5173

