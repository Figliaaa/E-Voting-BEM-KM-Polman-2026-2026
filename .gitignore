# =============================================================
# PEMIRA E-Voting – .gitignore
# =============================================================

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Environment / Secrets ────────────────────────────────────
.env

# ─── Build Output ─────────────────────────────────────────────
# Frontend Vite build
frontend/dist/
frontend/build/

# ─── Runtime Log Files ────────────────────────────────────────
# Backend auto-generates logs di backend/logs/
backend/logs/
*.log
logs/

# ─── OS & Editor Junk ─────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains IDEs (WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# ─── Misc ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional: jika pakai coverage / testing
coverage/
.nyc_output/
